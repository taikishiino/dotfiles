# シェル
brew "sheldon"   # zsh のプラグインマネージャ
brew "starship"  # プロンプト
brew "atuin"     # 履歴検索（Ctrl+R）
brew "fzf"       # あいまい検索
brew "zoxide"    # ディレクトリ移動（z / Ctrl+Q）

# 開発
brew "mise"      # ランタイムのバージョン管理
brew "gh"        # GitHub CLI
brew "gitui"     # Git の TUI（g）

# starship のアイコン表示に必要なフォント
cask "font-hackgen-nerd"
